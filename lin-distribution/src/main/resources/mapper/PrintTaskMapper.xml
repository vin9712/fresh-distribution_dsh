<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.PrintTaskMapper">

    <resultMap type="com.lin.distribution.domain.PrintTask" id="PrintTaskResult">
        <result property="id"    column="id"    />
        <result property="templateId"    column="template_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="requestId"    column="request_id"    />
        <result property="status"    column="status"    />
        <result property="version"    column="version"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPrintTaskVo">
        select id, template_id, order_id, request_id, status, version, create_by, create_time, update_by, update_time, remark from t_print_task
    </sql>

    <select id="selectPrintTaskList" parameterType="com.lin.distribution.domain.PrintTask" resultMap="PrintTaskResult">
        <include refid="selectPrintTaskVo"/>
        <where>
            <if test="templateId != null "> and template_id = #{templateId}</if>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="requestId != null  and requestId != ''"> and request_id = #{requestId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="version != null "> and version = #{version}</if>
        </where>
    </select>

    <select id="selectPrintTaskById" parameterType="Long" resultMap="PrintTaskResult">
        <include refid="selectPrintTaskVo"/>
        where id = #{id}
    </select>

    <insert id="insertPrintTask" parameterType="com.lin.distribution.domain.PrintTask" useGeneratedKeys="true" keyProperty="id">
        insert into t_print_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateId != null">template_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="requestId != null and requestId != ''">request_id,</if>
            <if test="status != null">status,</if>
            <if test="version != null">version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateId != null">#{templateId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="requestId != null and requestId != ''">#{requestId},</if>
            <if test="status != null">#{status},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePrintTask" parameterType="com.lin.distribution.domain.PrintTask">
        update t_print_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="requestId != null and requestId != ''">request_id = #{requestId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="version != null">version = #{version},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePrintTaskById" parameterType="Long">
        delete from t_print_task where id = #{id}
    </delete>

    <delete id="deletePrintTaskByIds" parameterType="String">
        delete from t_print_task where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>