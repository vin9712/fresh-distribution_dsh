<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.PrintTemplateMapper">

    <resultMap type="com.lin.distribution.domain.PrintTemplate" id="PrintTemplateResult">
        <result property="id"    column="id"    />
        <result property="customerId"    column="customer_id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="content"    column="content"    />
        <result property="type"    column="type"    />
        <result property="renderEngine"    column="render_engine"    />
        <result property="bindType"    column="bind_type"    />
        <result property="deliveryPointId"    column="delivery_point_id"    />
        <result property="copies"    column="copies"    />
        <result property="isDefault"       column="is_default"       />
        <result property="status"           column="status"           />
        <result property="testWatermark"    column="test_watermark"    />
        <result property="isDeleted"        column="is_deleted"        />
        <result property="version"    column="version"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPrintTemplateVo">
        select id, customer_id, code, name, content, type, render_engine, bind_type, delivery_point_id, copies, is_default, status, test_watermark, is_deleted, version, create_by, create_time, update_by, update_time, remark from t_print_template
    </sql>

    <select id="selectPrintTemplateList" parameterType="com.lin.distribution.domain.PrintTemplate" resultMap="PrintTemplateResult">
        <include refid="selectPrintTemplateVo"/>
        <where>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="code != null  and code != ''"> and code = #{code}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="bindType != null "> and bind_type = #{bindType}</if>
            <if test="deliveryPointId != null "> and delivery_point_id = #{deliveryPointId}</if>
            <if test="isDefault != null and isDefault != ''"> and is_default = #{isDefault}</if>
        </where>
        order by id desc
    </select>

    <select id="selectPrintTemplateById" parameterType="Long" resultMap="PrintTemplateResult">
        <include refid="selectPrintTemplateVo"/>
        where id = #{id}
    </select>

    <!-- 三级绑定解析：1客户+配送点组合 > 2客户 > 3全局默认（停用 is_deleted=1 不参与） -->
    <select id="selectBindTemplate" resultMap="PrintTemplateResult">
        <include refid="selectPrintTemplateVo"/>
        where is_deleted = 0
          and (
               (bind_type = 1 and customer_id = #{customerId} and delivery_point_id = #{deliveryPointId})
            or (bind_type = 2 and customer_id = #{customerId})
            or (bind_type = 3 and is_default = '1')
          )
        order by bind_type asc, id desc
        limit 1
    </select>

    <insert id="insertPrintTemplate" parameterType="com.lin.distribution.domain.PrintTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into t_print_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerId != null">customer_id,</if>
            <if test="code != null and code != ''">code,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="content != null and content != ''">content,</if>
            data,
            <if test="type != null">type,</if>
            <if test="renderEngine != null">render_engine,</if>
            <if test="bindType != null">bind_type,</if>
            <if test="deliveryPointId != null">delivery_point_id,</if>
            <if test="copies != null">copies,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="status != null">status,</if>
            <if test="testWatermark != null">test_watermark,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="version != null">version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerId != null">#{customerId},</if>
            <if test="code != null and code != ''">#{code},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="content != null and content != ''">#{content},</if>
            '{}',
            <if test="type != null">#{type},</if>
            <if test="renderEngine != null">#{renderEngine},</if>
            <if test="bindType != null">#{bindType},</if>
            <if test="deliveryPointId != null">#{deliveryPointId},</if>
            <if test="copies != null">#{copies},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="status != null">#{status},</if>
            <if test="testWatermark != null">#{testWatermark},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePrintTemplate" parameterType="com.lin.distribution.domain.PrintTemplate">
        update t_print_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="type != null">type = #{type},</if>
            <if test="renderEngine != null">render_engine = #{renderEngine},</if>
            <if test="bindType != null">bind_type = #{bindType},</if>
            <if test="deliveryPointId != null">delivery_point_id = #{deliveryPointId},</if>
            <if test="copies != null">copies = #{copies},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="status != null">status = #{status},</if>
            <if test="testWatermark != null">test_watermark = #{testWatermark},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="version != null">version = #{version},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePrintTemplateById" parameterType="Long">
        delete from t_print_template where id = #{id}
    </delete>

    <delete id="deletePrintTemplateByIds" parameterType="String">
        delete from t_print_template where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
