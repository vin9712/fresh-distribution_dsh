<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.DeliveryOrderMapper">

    <resultMap type="com.lin.distribution.domain.DeliveryOrder" id="DeliveryOrderResult">
        <result property="id"    column="id"    />
        <result property="customerId"    column="customer_id"    />
        <result property="deliveryPointId"    column="delivery_point_id"    />
        <result property="batchId"    column="batch_id"    />
        <result property="scopeType"    column="scope_type"    />
        <result property="docKind"    column="doc_kind"    />
        <result property="predecessorId"    column="predecessor_id"    />
        <result property="code"    column="code"    />
        <result property="status"    column="status"    />
        <result property="printCount"    column="print_count"    />
        <result property="voidReason"    column="void_reason"    />
        <result property="voidBy"    column="void_by"    />
        <result property="voidTime"    column="void_time"    />
        <result property="deliveryDate"    column="delivery_date"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="version"    column="version"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="customerName"    column="customerName"    />
        <result property="customerDeptName"    column="customerDeptName"    />
    </resultMap>

    <sql id="selectDeliveryOrderVo">
        select o.id, o.customer_id, o.delivery_point_id, o.batch_id, o.scope_type, o.doc_kind, o.predecessor_id,
               o.code, o.status, o.print_count, o.void_reason, o.void_by, o.void_time, o.delivery_date,
               o.is_deleted, o.version, o.create_by, o.create_time, o.update_by, o.update_time, o.remark,
               coalesce(customer.alias, customer.name) as customerName,
               cd.name as customerDeptName
        from t_delivery_order o
        left join t_customer_dept cd on cd.id = o.delivery_point_id
        left join t_customer customer on customer.id = o.customer_id
    </sql>

    <select id="selectDeliveryOrderList" parameterType="com.lin.distribution.domain.DeliveryOrder" resultMap="DeliveryOrderResult">
        <include refid="selectDeliveryOrderVo"/>
        <where>
            <if test="customerId != null "> and o.customer_id = #{customerId}</if>
            <if test="deliveryPointId != null "> and o.delivery_point_id = #{deliveryPointId}</if>
            <if test="code != null  and code != ''"> and o.code = #{code}</if>
            <if test="status != null "> and o.status = #{status}</if>
            <if test="deliveryDate != null "> and o.delivery_date = #{deliveryDate}</if>
        </where>
    </select>

    <select id="selectDeliveryOrderById" parameterType="Long" resultMap="DeliveryOrderResult">
        <include refid="selectDeliveryOrderVo"/>
        where o.id = #{id}
    </select>

    <select id="selectListByIds" resultMap="DeliveryOrderResult">
        <include refid="selectDeliveryOrderVo"/>
        where o.id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <insert id="insertDeliveryOrder" parameterType="com.lin.distribution.domain.DeliveryOrder" useGeneratedKeys="true" keyProperty="id">
        insert into t_delivery_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerId != null">customer_id,</if>
            <if test="deliveryPointId != null">delivery_point_id,</if>
            <if test="batchId != null">batch_id,</if>
            <if test="scopeType != null and scopeType != ''">scope_type,</if>
            <if test="docKind != null">doc_kind,</if>
            <if test="predecessorId != null">predecessor_id,</if>
            <if test="code != null and code != ''">code,</if>
            <if test="status != null">status,</if>
            <if test="printCount != null">print_count,</if>
            <if test="voidReason != null">void_reason,</if>
            <if test="voidBy != null">void_by,</if>
            <if test="voidTime != null">void_time,</if>
            <if test="deliveryDate != null">delivery_date,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="version != null">version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerId != null">#{customerId},</if>
            <if test="deliveryPointId != null">#{deliveryPointId},</if>
            <if test="batchId != null">#{batchId},</if>
            <if test="scopeType != null and scopeType != ''">#{scopeType},</if>
            <if test="docKind != null">#{docKind},</if>
            <if test="predecessorId != null">#{predecessorId},</if>
            <if test="code != null and code != ''">#{code},</if>
            <if test="status != null">#{status},</if>
            <if test="printCount != null">#{printCount},</if>
            <if test="voidReason != null">#{voidReason},</if>
            <if test="voidBy != null">#{voidBy},</if>
            <if test="voidTime != null">#{voidTime},</if>
            <if test="deliveryDate != null">#{deliveryDate},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDeliveryOrder" parameterType="com.lin.distribution.domain.DeliveryOrder">
        update t_delivery_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="deliveryPointId != null">delivery_point_id = #{deliveryPointId},</if>
            <if test="batchId != null">batch_id = #{batchId},</if>
            <if test="scopeType != null and scopeType != ''">scope_type = #{scopeType},</if>
            <if test="docKind != null">doc_kind = #{docKind},</if>
            <if test="predecessorId != null">predecessor_id = #{predecessorId},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="status != null">status = #{status},</if>
            <if test="printCount != null">print_count = #{printCount},</if>
            <if test="voidReason != null">void_reason = #{voidReason},</if>
            <if test="voidBy != null">void_by = #{voidBy},</if>
            <if test="voidTime != null">void_time = #{voidTime},</if>
            <if test="deliveryDate != null">delivery_date = #{deliveryDate},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="version != null">version = #{version},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeliveryOrderById" parameterType="Long">
        delete from t_delivery_order where id = #{id}
    </delete>

    <delete id="deleteDeliveryOrderByIds" parameterType="String">
        delete from t_delivery_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
