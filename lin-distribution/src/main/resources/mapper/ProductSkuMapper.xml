<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.ProductSkuMapper">

    <resultMap type="com.lin.distribution.domain.ProductSku" id="ProductSkuResult">
        <result property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="spuId" column="spu_id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="mnemonicCode" column="mnemonic_code"/>
        <result property="unit" column="unit"/>
        <result property="specName" column="spec_name"/>
        <result property="isWeighted" column="is_weighted"/>
        <result property="baseUnit" column="base_unit"/>
        <result property="conversionRate" column="conversion_rate"/>
        <result property="salePrice" column="sale_price"/>
        <result property="saleable" column="saleable"/>
        <result property="valid" column="valid"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectProductSkuVo">
        select sku.id,
        sku.category_id,
        sku.spu_id,
        category.name as categoryName,
        category.code as categoryCode,
        sku.code,
        sku.name,
        sku.mnemonic_code,
        sku.unit,
        sku.spec_name,
        sku.is_weighted,
        sku.base_unit,
        sku.conversion_rate,
        sku.sale_price,
        sku.saleable,
        sku.valid,
        sku.is_deleted,
        sku.create_by,
        sku.create_time,
        sku.update_by,
        sku.update_time,
        sku.remark
        from t_product_sku sku
        left join t_product_spu spu on sku.spu_id = spu.id
        left join t_product_category category on sku.category_id = category.id
    </sql>

    <select id="selectProductSkuList" parameterType="com.lin.distribution.domain.ProductSku"
            resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        <include refid="selectProductSkuWhere"/>
        order by sku.create_time
    </select>

    <!-- 采购新增商品选品：仅按品名/助记码/别名 + valid 过滤（不能用共享片段：
         多参数 @Param 绑定下片段里引用 categoryId 等 POJO 属性会 BindingException） -->
    <select id="selectProductSkuOptions" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        <where>
            <if test="name != null and name != ''">
                and ( sku.name like concat('%', #{name}, '%')
                      or sku.mnemonic_code like concat('%', #{name}, '%')
                      or sku.id in (select sku_id from product_alias where alias like concat('%', #{name}, '%'))
                    )
            </if>
            <if test="valid != null">and sku.valid = #{valid}</if>
        </where>
        order by sku.create_time
        limit #{limit}
    </select>

    <sql id="selectProductSkuWhere">
        <where>
            <if test="categoryId != null">and sku.category_id = #{categoryId}</if>
            <if test="spuId != null">and sku.spu_id = #{spuId}</if>
            <if test="name != null  and name != ''">
                and ( sku.name like concat('%', #{name}, '%')
                      or sku.mnemonic_code like concat('%', #{name}, '%')
                      or sku.id in (select sku_id from product_alias where alias like concat('%', #{name}, '%'))
                    )
            </if>
            <if test="salePrice != null ">and sku.sale_price = #{salePrice}</if>
            <if test="saleable != null ">and sku.saleable = #{saleable}</if>
            <if test="valid != null ">and sku.valid = #{valid}</if>
            <if test="matchedSpu != null and matchedSpu == 0">and sku.spu_id is null</if>
            <if test="matchedSpu != null and matchedSpu == 1">and sku.spu_id is not null</if>
        </where>
    </sql>

    <select id="selectProductSkuById" parameterType="Long" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        where sku.id = #{id}
    </select>

    <insert id="insertProductSku" parameterType="com.lin.distribution.domain.ProductSku" useGeneratedKeys="true"
            keyProperty="id">
        insert into t_product_sku
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="spuId != null">spu_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="code != null and code != ''">code,</if>
            <if test="mnemonicCode != null and mnemonicCode != ''">mnemonic_code,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="specName != null">spec_name,</if>
            <if test="isWeighted != null">is_weighted,</if>
            <if test="baseUnit != null">base_unit,</if>
            <if test="conversionRate != null">conversion_rate,</if>
            <if test="salePrice != null">sale_price,</if>
            <if test="saleable != null">saleable,</if>
            <if test="valid != null">valid,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="spuId != null">#{spuId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="code != null and code != ''">#{code},</if>
            <if test="mnemonicCode != null and mnemonicCode != ''">#{mnemonicCode},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="specName != null">#{specName},</if>
            <if test="isWeighted != null">#{isWeighted},</if>
            <if test="baseUnit != null">#{baseUnit},</if>
            <if test="conversionRate != null">#{conversionRate},</if>
            <if test="salePrice != null">#{salePrice},</if>
            <if test="saleable != null">#{saleable},</if>
            <if test="valid != null">#{valid},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateProductSku" parameterType="com.lin.distribution.domain.ProductSku">
        update t_product_sku
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="spuId != null">spu_id = #{spuId},</if>
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="mnemonicCode != null and mnemonicCode != ''">mnemonic_code = #{mnemonicCode},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="specName != null">spec_name = #{specName},</if>
            <if test="isWeighted != null">is_weighted = #{isWeighted},</if>
            <if test="baseUnit != null">base_unit = #{baseUnit},</if>
            <if test="conversionRate != null">conversion_rate = #{conversionRate},</if>
            <if test="salePrice != null">sale_price = #{salePrice},</if>
            <if test="saleable != null">saleable = #{saleable},</if>
            <if test="valid != null">valid = #{valid},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProductSkuById" parameterType="String">
        delete from t_product_sku where id = #{id}
    </delete>

    <delete id="deleteProductSkuByIds" parameterType="String">
        delete from t_product_sku where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectProductSkuByCategoryNameSpecUnit" resultMap="ProductSkuResult">
        <include refid="selectProductSkuVo"/>
        <where>
            <if test="categoryId != null">and sku.category_id = #{categoryId}</if>
            <if test="name != null and name != ''">and sku.name = #{name}</if>
            <if test="specName != null">and sku.spec_name = #{specName}</if>
            <if test="unit != null and unit != ''">and sku.unit = #{unit}</if>
            and sku.is_deleted = 0
        </where>
    </select>

    <update id="undoMatchProductSku" parameterType="Long">
        update t_product_sku
        set spu_id = null where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
