<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.DeliverySkuOverrideMapper">

    <resultMap type="com.lin.distribution.domain.DeliverySkuOverride" id="DeliverySkuOverrideResult">
        <result property="id" column="id"/>
        <result property="deliveryPointId" column="delivery_point_id"/>
        <result property="deliveryPointName" column="delivery_point_name"/>
        <result property="skuId" column="sku_id"/>
        <result property="skuName" column="sku_name"/>
        <result property="isAvailable" column="is_available"/>
        <result property="priceOverride" column="price_override"/>
        <result property="aliasOverride" column="alias_override"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="expireDate" column="expire_date"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectDeliverySkuOverrideVo">
        select dso.id,
        dso.delivery_point_id,
        dept.name as delivery_point_name,
        dso.sku_id,
        sku.name as sku_name,
        dso.is_available,
        dso.price_override,
        dso.alias_override,
        dso.effective_date,
        dso.expire_date,
        dso.created_at,
        dso.updated_at
        from delivery_sku_override dso
        left join t_customer_dept dept on dso.delivery_point_id = dept.id
        left join t_product_sku sku on dso.sku_id = sku.id
    </sql>

    <select id="selectDeliverySkuOverrideById" parameterType="Long" resultMap="DeliverySkuOverrideResult">
        <include refid="selectDeliverySkuOverrideVo"/>
        where dso.id = #{id}
    </select>

    <select id="selectDeliverySkuOverrideList" parameterType="com.lin.distribution.domain.DeliverySkuOverride"
            resultMap="DeliverySkuOverrideResult">
        <include refid="selectDeliverySkuOverrideVo"/>
        <where>
            <if test="deliveryPointId != null">and dso.delivery_point_id = #{deliveryPointId}</if>
            <if test="skuId != null">and dso.sku_id = #{skuId}</if>
            <if test="isAvailable != null">and dso.is_available = #{isAvailable}</if>
        </where>
        order by dso.id desc
    </select>

    <select id="selectActiveByPointAndSku" resultMap="DeliverySkuOverrideResult">
        <include refid="selectDeliverySkuOverrideVo"/>
        where dso.delivery_point_id = #{deliveryPointId}
        and dso.sku_id = #{skuId}
        and (dso.effective_date is null or dso.effective_date &lt;= #{deliveryDate})
        and (dso.expire_date is null or dso.expire_date &gt;= #{deliveryDate})
        order by dso.effective_date desc, dso.id desc
        limit 1
    </select>

    <select id="selectByPoint" resultMap="DeliverySkuOverrideResult">
        <include refid="selectDeliverySkuOverrideVo"/>
        where dso.delivery_point_id = #{deliveryPointId}
    </select>

    <insert id="insertDeliverySkuOverride" parameterType="com.lin.distribution.domain.DeliverySkuOverride"
            useGeneratedKeys="true" keyProperty="id">
        insert into delivery_sku_override
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryPointId != null">delivery_point_id,</if>
            <if test="skuId != null">sku_id,</if>
            <if test="isAvailable != null">is_available,</if>
            <if test="priceOverride != null">price_override,</if>
            <if test="aliasOverride != null">alias_override,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="expireDate != null">expire_date,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryPointId != null">#{deliveryPointId},</if>
            <if test="skuId != null">#{skuId},</if>
            <if test="isAvailable != null">#{isAvailable},</if>
            <if test="priceOverride != null">#{priceOverride},</if>
            <if test="aliasOverride != null">#{aliasOverride},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="expireDate != null">#{expireDate},</if>
        </trim>
    </insert>

    <update id="updateDeliverySkuOverride" parameterType="com.lin.distribution.domain.DeliverySkuOverride">
        update delivery_sku_override
        <trim prefix="SET" suffixOverrides=",">
            <if test="isAvailable != null">is_available = #{isAvailable},</if>
            <if test="priceOverride != null">price_override = #{priceOverride},</if>
            <if test="aliasOverride != null">alias_override = #{aliasOverride},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeliverySkuOverrideById" parameterType="Long">
        delete from delivery_sku_override where id = #{id}
    </delete>

    <delete id="deleteDeliverySkuOverrideByIds" parameterType="Long">
        delete from delivery_sku_override where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
