            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSaleOrderDetail" parameterType="com.lin.distribution.domain.SaleOrderDetail">
        update t_sale_order_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="customerDeptId != null">customer_dept_id = #{customerDeptId},</if>
            <if test="skuId != null">sku_id = #{skuId},</if>
            <if test="orderCode != null and orderCode != ''">order_code = #{orderCode},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productUnit != null">product_unit = #{productUnit},</if>
            <if test="productPrice != null">product_price = #{productPrice},</if>
            <if test="productSpec != null">product_spec = #{productSpec},</if>
            <if test="num != null">num = #{num},</if>
            <if test="expectAmount != null">expect_amount = #{expectAmount},</if>
            <if test="actualPrice != null">actual_price = #{actualPrice},</if>
            <if test="actualNum != null">actual_num = #{actualNum},</if>
            <if test="actualAmount != null">actual_amount = #{actualAmount},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="version != null">version = #{version},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSaleOrderDetailById" parameterType="Long">
        delete from t_sale_order_detail where id = #{id}
    </delete>

    <delete id="deleteSaleOrderDetailByIds" parameterType="String">
        delete from t_sale_order_detail where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteSaleOrderDetailByOrderId">
        delete from t_sale_order_detail where order_id = #{orderId}
    </delete>

    <select id="selectAggregatedByDeliveryDate" parameterType="java.time.LocalDate" resultMap="SaleOrderDetailResult">
        select d.customer_id,
               d.customer_dept_id,
               d.sku_id,
               d.product_name,
               d.product_unit,
               d.product_spec,
               d.product_price,
               sum(d.num) as num,
               sum(d.num * d.product_price) as expect_amount
        from t_sale_order_detail d
        inner join t_sale_order o on o.id = d.order_id
        where o.delivery_date = #{deliveryDate}
          and o.status = 1
          and o.is_deleted = 0
          and d.is_deleted = 0
        group by d.customer_id, d.customer_dept_id, d.sku_id, d.product_name, d.product_unit, d.product_spec, d.product_price
        order by d.customer_id, d.customer_dept_id, d.product_name
    </select>

    <!-- 常用商品统计：近N天下单频率最高的 SKU（录单页"常用"面板）
         仅统计已确认及后续状态的订单（排除制单草稿），临时商品(sku_id 为空)不参与 -->
    <select id="selectFrequentSkuList" resultMap="SaleOrderDetailResult">
        select d.sku_id,
               max(d.product_name)  as product_name,
               max(d.product_unit)  as product_unit,
               max(d.product_spec)  as product_spec,
               count(*)             as order_count,
               date_format(max(d.create_time), '%Y-%m-%d %H:%i:%s') as last_order_time
        from t_sale_order_detail d
        inner join t_sale_order o on o.id = d.order_id
        where o.customer_id = #{customerId}
          and o.status > 0
          and o.is_deleted = 0
          and d.is_deleted = 0
          and d.sku_id is not null
          and d.create_time &gt;= #{startTime}
        group by d.sku_id
        order by order_count desc, last_order_time desc
        limit #{limit}
    </select>
</mapper>