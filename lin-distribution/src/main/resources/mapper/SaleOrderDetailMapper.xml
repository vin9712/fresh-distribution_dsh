<mapper namespace="com.lin.distribution.mapper.SaleOrderDetailMapper">

    <resultMap type="com.lin.distribution.domain.SaleOrderDetail" id="SaleOrderDetailResult">
        <result property="id"    column="id"    />
        <result property="orderId"    column="order_id"    />
        <result property="customerId"    column="customer_id"    />
        <result property="customerDeptId"    column="customer_dept_id"    />
        <result property="skuId"    column="sku_id"    />
        <result property="orderCode"    column="order_code"    />
        <result property="productName"    column="product_name"    />
        <result property="productUnit"    column="product_unit"    />
        <result property="productPrice"    column="product_price"    />
        <result property="productSpec"    column="product_spec"    />
        <result property="num"    column="num"    />
        <result property="expectAmount"    column="expect_amount"    />
        <result property="actualPrice"    column="actual_price"    />
        <result property="actualNum"    column="actual_num"    />
        <result property="actualAmount"    column="actual_amount"    />
        <result property="sort"    column="sort"    />
        <result property="isDeleted"    column="is_deleted"    />
        <result property="version"    column="version"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="orderCount"    column="order_count"    />
        <result property="lastOrderTime"    column="last_order_time"    />
    </resultMap>

    <sql id="selectSaleOrderDetailVo">
        select id, order_id, customer_id, customer_dept_id, sku_id, order_code, product_name, product_unit, product_price, product_spec, num, expect_amount, actual_price, actual_num, actual_amount, sort, is_deleted, version, create_by, create_time, update_by, update_time, remark from t_sale_order_detail
    </sql>

    <select id="selectSaleOrderDetailList" parameterType="com.lin.distribution.domain.SaleOrderDetail" resultMap="SaleOrderDetailResult">
        <include refid="selectSaleOrderDetailVo"/>
        <where>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="customerDeptId != null "> and customer_dept_id = #{customerDeptId}</if>
            <if test="skuId != null "> and sku_id = #{skuId}</if>
            <if test="orderCode != null  and orderCode != ''"> and order_code = #{orderCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
        </where>
    </select>

    <select id="selectSaleOrderDetailById" parameterType="Long" resultMap="SaleOrderDetailResult">
        <include refid="selectSaleOrderDetailVo"/>
        where id = #{id}
    </select>

    <insert id="insertSaleOrderDetail" parameterType="com.lin.distribution.domain.SaleOrderDetail" useGeneratedKeys="true" keyProperty="id">
        insert into t_sale_order_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="customerDeptId != null">customer_dept_id,</if>
            <if test="skuId != null">sku_id,</if>
            <if test="orderCode != null and orderCode != ''">order_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productUnit != null">product_unit,</if>
            <if test="productPrice != null">product_price,</if>
            <if test="productSpec != null">product_spec,</if>
            <if test="num != null">num,</if>
            <if test="expectAmount != null">expect_amount,</if>
            <if test="actualPrice != null">actual_price,</if>
            <if test="actualNum != null">actual_num,</if>
            <if test="actualAmount != null">actual_amount,</if>
            <if test="sort != null">sort,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="version != null">version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="customerDeptId != null">#{customerDeptId},</if>
            <if test="skuId != null">#{skuId},</if>
            <if test="orderCode != null and orderCode != ''">#{orderCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productUnit != null">#{productUnit},</if>
            <if test="productPrice != null">#{productPrice},</if>
            <if test="productSpec != null">#{productSpec},</if>
            <if test="num != null">#{num},</if>
            <if test="expectAmount != null">#{expectAmount},</if>
            <if test="actualPrice != null">#{actualPrice},</if>
            <if test="actualNum != null">#{actualNum},</if>
            <if test="actualAmount != null">#{actualAmount},</if>
            <if test="sort != null">#{sort},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
