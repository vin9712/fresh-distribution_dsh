    <sql id="selectSaleOrderDetailVo">
        select id, order_id, customer_id, customer_dept_id, sku_id, order_code, product_name, product_unit, product_price, product_spec, num, expect_amount, price_source, ref_price, price_reason, loss_reason, actual_price, actual_num, actual_amount, sort, is_deleted, version, create_by, create_time, update_by, update_time, remark from t_sale_order_detail
    </sql>

    <select id="selectSaleOrderDetailList" parameterType="com.lin.distribution.domain.SaleOrderDetail" resultMap="SaleOrderDetailResult">
        <include refid="selectSaleOrderDetailVo"/>
        <where>
            <if test="orderId != null "> and order_id = #{orderId}</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="customerDeptId != null "> and customer_dept_id = #{customerDeptId}</if>
            <if test="skuId != null "> and sku_id = #{skuId}</if>
            <if test="orderCode != null  and orderCode != ''"> and order_code = #{orderCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
        </where>
    </select>

    <select id="selectSaleOrderDetailById" parameterType="Long" resultMap="SaleOrderDetailResult">
        <include refid="selectSaleOrderDetailVo"/>
        where id = #{id}
    </select>

    <insert id="insertSaleOrderDetail" parameterType="com.lin.distribution.domain.SaleOrderDetail" useGeneratedKeys="true" keyProperty="id">
        insert into t_sale_order_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="customerDeptId != null">customer_dept_id,</if>
            <if test="skuId != null">sku_id,</if>
            <if test="orderCode != null and orderCode != ''">order_code,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="productUnit != null">product_unit,</if>
            <if test="productPrice != null">product_price,</if>
            <if test="productSpec != null">product_spec,</if>
            <if test="num != null">num,</if>
            <if test="expectAmount != null">expect_amount,</if>
            <if test="priceSource != null and priceSource != ''">price_source,</if>
            <if test="refPrice != null">ref_price,</if>
            <if test="priceReason != null and priceReason != ''">price_reason,</if>
            <if test="lossReason != null">loss_reason,</if>
            <if test="actualPrice != null">actual_price,</if>
            <if test="actualNum != null">actual_num,</if>
            <if test="actualAmount != null">actual_amount,</if>
            <if test="sort != null">sort,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="version != null">version,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="customerDeptId != null">#{customerDeptId},</if>
            <if test="skuId != null">#{skuId},</if>
            <if test="orderCode != null and orderCode != ''">#{orderCode},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="productUnit != null">#{productUnit},</if>
            <if test="productPrice != null">#{productPrice},</if>
            <if test="productSpec != null">#{productSpec},</if>
            <if test="num != null">#{num},</if>
            <if test="expectAmount != null">#{expectAmount},</if>
            <if test="priceSource != null and priceSource != ''">#{priceSource},</if>
            <if test="refPrice != null">#{refPrice},</if>
            <if test="priceReason != null and priceReason != ''">#{priceReason},</if>
            <if test="lossReason != null">#{lossReason},</if>
            <if test="actualPrice != null">#{actualPrice},</if>
            <if test="actualNum != null">#{actualNum},</if>
            <if test="actualAmount != null">#{actualAmount},</if>
            <if test="sort != null">#{sort},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="version != null">#{version},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateSaleOrderDetail" parameterType="com.lin.distribution.domain.SaleOrderDetail">
        update t_sale_order_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="customerDeptId != null">customer_dept_id = #{customerDeptId},</if>
            <if test="skuId != null">sku_id = #{skuId},</if>
            <if test="orderCode != null and orderCode != ''">order_code = #{orderCode},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="productUnit != null">product_unit = #{productUnit},</if>
            <if test="productPrice != null">product_price = #{productPrice},</if>
            <if test="productSpec != null">product_spec = #{productSpec},</if>
            <if test="num != null">num = #{num},</if>
            <if test="expectAmount != null">expect_amount = #{expectAmount},</if>
            <if test="priceSource != null and priceSource != ''">price_source = #{priceSource},</if>
            <if test="refPrice != null">ref_price = #{refPrice},</if>
            <if test="priceReason != null and priceReason != ''">price_reason = #{priceReason},</if>
            <if test="lossReason != null">loss_reason = #{lossReason},</if>
            <if test="actualPrice != null">actual_price = #{actualPrice},</if>
            <if test="actualNum != null">actual_num = #{actualNum},</if>
            <if test="actualAmount != null">actual_amount = #{actualAmount},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
            <if test="version != null">version = #{version},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 写入单行实收数据（草稿保存 / 确认验收共用，服务层按行循环） -->
    <update id="updateActualBatch">
        update t_sale_order_detail
        set actual_num = #{item.actualNum},
            <choose>
                <when test="item.actualPrice != null">actual_price = #{item.actualPrice},</when>
                <otherwise>actual_price = null,</otherwise>
            </choose>
            loss_reason = #{item.lossReason},
            <choose>
                <when test="item.actualAmount != null">actual_amount = #{item.actualAmount},</when>
                <otherwise>actual_amount = null,</otherwise>
            </choose>
            update_time = now()
        where id = #{item.id}
    </update>

    <!-- 撤销验收：清空订单全部实收数据（回退 3→2 默认清空） -->
    <update id="clearActualByOrderId">
        update t_sale_order_detail
        set actual_num = null,
            actual_price = null,
            actual_amount = null,
            loss_reason = null,
            update_time = now()
        where order_id = #{orderId} and is_deleted = 0
    </update>

    <delete id="deleteSaleOrderDetailById" parameterType="Long">
        delete from t_sale_order_detail where id = #{id}
    </delete>

    <delete id="deleteSaleOrderDetailByIds" parameterType="String">
        delete from t_sale_order_detail where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteSaleOrderDetailByOrderId">
        delete from t_sale_order_detail where order_id = #{orderId}
    </delete>

    <!-- S14/T3 统一生成：按订单查有效订单行原始明细（不聚合；聚合移 Java 侧，保留 行→单 映射落 source_item 台账） -->
    <select id="selectValidByOrderIdIn" resultMap="SaleOrderDetailResult">
        select d.id,
               d.order_id,
               d.customer_id,
               d.customer_dept_id,
               d.sku_id,
               d.order_code,
               d.product_name,
               d.product_unit,
               d.product_price,
               d.product_spec,
               d.num
        from t_sale_order_detail d
        where d.is_deleted = 0
          and d.order_id in
        <foreach item="orderId" collection="orderIds" open="(" separator="," close=")">
            #{orderId}
        </foreach>
        order by d.order_id, d.sort, d.id
    </select>

    <!-- 生成单据预览：按品类分组汇总（临时商品归"临时商品"） -->
    <select id="selectPreviewByOrderIds" resultMap="SaleOrderDetailResult">
        select d.sku_id,
               d.product_name,
               d.product_unit,
               d.product_spec,
               coalesce(pc.name, '临时商品') as category_name,
               sum(d.num) as num,
               min(d.product_price) as product_price,
               sum(d.num * d.product_price) as expect_amount
        from t_sale_order_detail d
        inner join t_sale_order o on o.id = d.order_id
        left join t_product_sku ps on ps.id = d.sku_id
        left join t_product_category pc on pc.id = ps.category_id
        where o.id in
        <foreach item="orderId" collection="orderIds" open="(" separator="," close=")">
            #{orderId}
        </foreach>
          and o.status = 1
          and o.is_deleted = 0
          and d.is_deleted = 0
        group by d.sku_id, d.product_name, d.product_unit, d.product_spec, pc.name
        order by pc.name, d.product_name
    </select>

    <select id="selectFrequentSkuList" resultMap="SaleOrderDetailResult">
        select d.sku_id,
               max(d.product_name)  as product_name,
               max(d.product_unit)  as product_unit,
               max(d.product_spec)  as product_spec,
               count(*)             as order_count,
               date_format(max(d.create_time), '%Y-%m-%d %H:%i:%s') as last_order_time
        from t_sale_order_detail d
        inner join t_sale_order o on o.id = d.order_id
        where o.customer_id = #{customerId}
          and o.status > 0
          and o.is_deleted = 0
          and d.is_deleted = 0
          and d.sku_id is not null
          and d.create_time &gt;= #{startTime}
        <!-- 配送点白名单：通用池∪本点专属（dept_id空=通用）；未传配送点时仅显示通用商品，避免泄漏他点专属 -->
        and exists (select 1 from customers_sku cs
                    where cs.customer_id = o.customer_id
                      and cs.sku_id = d.sku_id
                      and cs.status = 1
                    <if test="deliveryPointId != null">
                      and (cs.dept_id is null or cs.dept_id = #{deliveryPointId})
                    </if>
                    <if test="deliveryPointId == null">
                      and cs.dept_id is null
                    </if>)
        group by d.sku_id
        order by order_count desc, last_order_time desc
        limit #{limit}
    </select>

    <!-- 订单是否被有效送货单占用（S14/G4/G6 统一判定：si 未软删 + d 未软删 + d 非作废） -->
    <select id="existsValidAllocation" resultType="boolean">
        select exists(
            select 1
            from t_delivery_source_item si
            join t_delivery_order d on d.id = si.delivery_id
            where si.sale_order_id = #{orderId}
              and si.is_deleted = 0
              and d.is_deleted = 0
              and d.status != 3
        )
    </select>
</mapper>