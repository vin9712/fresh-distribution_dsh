<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.SaleOrderDraftMapper">

    <resultMap type="com.lin.distribution.domain.SaleOrderDraft" id="SaleOrderDraftResult">
        <result property="id"         column="id"          />
        <result property="draftKey"   column="draft_key"   />
        <result property="userId"     column="user_id"     />
        <result property="payload"    column="payload"     />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectByDraftKey" resultMap="SaleOrderDraftResult">
        select id, draft_key, user_id, payload, create_time, update_time
        from t_sale_order_draft
        where draft_key = #{draftKey}
    </select>

    <!-- 按 draftKey 幂等覆盖：存在则更新 payload/user/update_time -->
    <insert id="upsert" parameterType="com.lin.distribution.domain.SaleOrderDraft">
        insert into t_sale_order_draft (draft_key, user_id, payload, create_time, update_time)
        values (#{draftKey}, #{userId}, #{payload}, now(), now())
        on duplicate key update
            user_id = values(user_id),
            payload = values(payload),
            update_time = now()
    </insert>

    <delete id="deleteByDraftKey">
        delete from t_sale_order_draft where draft_key = #{draftKey}
    </delete>
</mapper>
