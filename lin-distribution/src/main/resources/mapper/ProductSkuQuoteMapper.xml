    </update>

    <delete id="deleteProductSkuQuoteById" parameterType="Long">
        delete from t_product_sku_quote where id = #{id}
    </delete>

    <delete id="deleteProductSkuQuoteByIds" parameterType="String">
        delete from t_product_sku_quote where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>