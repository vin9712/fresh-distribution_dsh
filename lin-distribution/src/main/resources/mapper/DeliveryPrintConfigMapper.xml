<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.DeliveryPrintConfigMapper">

    <resultMap type="com.lin.distribution.domain.DeliveryPrintConfig" id="DeliveryPrintConfigResult">
        <result property="id"              column="id"              />
        <result property="deliveryOrderId" column="delivery_order_id" />
        <result property="splitMode"       column="split_mode"      />
        <result property="mediaType"       column="media_type"      />
        <result property="rowsPerPage"     column="rows_per_page"   />
        <result property="structureJson"   column="structure_json"  />
        <result property="autoGenerated"   column="auto_generated"  />
        <result property="version"         column="version"         />
        <result property="isDeleted"       column="is_deleted"      />
        <result property="createBy"        column="create_by"       />
        <result property="createTime"      column="create_time"     />
        <result property="updateBy"        column="update_by"       />
        <result property="updateTime"      column="update_time"     />
        <result property="remark"          column="remark"          />
    </resultMap>

    <sql id="selectDeliveryPrintConfigVo">
        select id, delivery_order_id, split_mode, media_type, rows_per_page, structure_json,
               auto_generated, version, is_deleted, create_by, create_time, update_by, update_time, remark
        from t_delivery_print_config
    </sql>

    <select id="selectDeliveryPrintConfigById" parameterType="Long" resultMap="DeliveryPrintConfigResult">
        <include refid="selectDeliveryPrintConfigVo"/>
        where id = #{id} and is_deleted = 0
    </select>

    <select id="selectByDeliveryOrderId" parameterType="Long" resultMap="DeliveryPrintConfigResult">
        <include refid="selectDeliveryPrintConfigVo"/>
        where delivery_order_id = #{deliveryOrderId} and is_deleted = 0
        limit 1
    </select>

    <!-- W0-2.2 UPSERT 防并发：按送货单ID锁行（unq_delivery_order 唯一键兜底） -->
    <select id="selectByDeliveryOrderIdForUpdate" parameterType="Long" resultMap="DeliveryPrintConfigResult">
        <include refid="selectDeliveryPrintConfigVo"/>
        where delivery_order_id = #{deliveryOrderId} and is_deleted = 0
        limit 1
        for update
    </select>

    <insert id="insertDeliveryPrintConfig" parameterType="com.lin.distribution.domain.DeliveryPrintConfig" useGeneratedKeys="true" keyProperty="id">
        insert into t_delivery_print_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryOrderId != null">delivery_order_id,</if>
            <if test="splitMode != null and splitMode != ''">split_mode,</if>
            <if test="mediaType != null and mediaType != ''">media_type,</if>
            <if test="rowsPerPage != null">rows_per_page,</if>
            <if test="structureJson != null">structure_json,</if>
            <if test="autoGenerated != null">auto_generated,</if>
            <if test="version != null">version,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryOrderId != null">#{deliveryOrderId},</if>
            <if test="splitMode != null and splitMode != ''">#{splitMode},</if>
            <if test="mediaType != null and mediaType != ''">#{mediaType},</if>
            <if test="rowsPerPage != null">#{rowsPerPage},</if>
            <if test="structureJson != null">#{structureJson},</if>
            <if test="autoGenerated != null">#{autoGenerated},</if>
            <if test="version != null">#{version},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateDeliveryPrintConfig" parameterType="com.lin.distribution.domain.DeliveryPrintConfig">
        update t_delivery_print_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="splitMode != null and splitMode != ''">split_mode = #{splitMode},</if>
            <if test="mediaType != null and mediaType != ''">media_type = #{mediaType},</if>
            <if test="rowsPerPage != null">rows_per_page = #{rowsPerPage},</if>
            <if test="structureJson != null">structure_json = #{structureJson},</if>
            <if test="autoGenerated != null">auto_generated = #{autoGenerated},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            version = version + 1,
        </trim>
        where id = #{id}
    </update>
</mapper>
