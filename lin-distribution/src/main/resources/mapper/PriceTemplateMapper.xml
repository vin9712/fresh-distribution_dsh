<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.PriceTemplateMapper">

    <resultMap type="com.lin.distribution.domain.PriceTemplate" id="PriceTemplateResult">
        <id     property="id"           column="id"          />
        <result property="name"         column="name"        />
        <result property="status"       column="status"      />
        <result property="effectiveDate" column="effective_date" />
        <result property="expireDate"   column="expire_date" />
        <result property="isDefault"    column="is_default"  />
        <result property="createBy"     column="create_by"   />
        <result property="createTime"   column="create_time" />
        <result property="updateBy"     column="update_by"   />
        <result property="updateTime"   column="update_time" />
        <result property="remark"       column="remark"      />
    </resultMap>

    <sql id="selectPriceTemplateVo">
        select id, name, status, effective_date, expire_date, is_default, create_by, create_time, update_by, update_time, remark
        from price_template
    </sql>

    <select id="selectPriceTemplateById" parameterType="Long" resultMap="PriceTemplateResult">
        <include refid="selectPriceTemplateVo"/>
        where id = #{id}
    </select>

    <select id="selectPriceTemplateList" parameterType="com.lin.distribution.domain.PriceTemplate" resultMap="PriceTemplateResult">
        <include refid="selectPriceTemplateVo"/>
        <where>
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="isDefault != null and isDefault != ''"> and is_default = #{isDefault}</if>
        </where>
        order by id desc
    </select>

    <select id="selectDefaultTemplate" resultMap="PriceTemplateResult">
        <include refid="selectPriceTemplateVo"/>
        where is_default = '1' and status = '0'
        order by id desc limit 1
    </select>

    <select id="selectTemplateByCustomerId" parameterType="Long" resultMap="PriceTemplateResult">
        select t.id, t.name, t.status, t.effective_date, t.expire_date, t.is_default, t.create_by, t.create_time, t.update_by, t.update_time, t.remark
        from price_template t
        inner join price_template_customer c on c.template_id = t.id
        where c.customer_id = #{customerId} and t.status = '0'
        order by t.id desc limit 1
    </select>

    <insert id="insertPriceTemplate" parameterType="com.lin.distribution.domain.PriceTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into price_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="effectiveDate != null">effective_date,</if>
            <if test="expireDate != null">expire_date,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="effectiveDate != null">#{effectiveDate},</if>
            <if test="expireDate != null">#{expireDate},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePriceTemplate" parameterType="com.lin.distribution.domain.PriceTemplate">
        update price_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="effectiveDate != null">effective_date = #{effectiveDate},</if>
            <if test="expireDate != null">expire_date = #{expireDate},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePriceTemplateByIds" parameterType="Long">
        delete from price_template where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
