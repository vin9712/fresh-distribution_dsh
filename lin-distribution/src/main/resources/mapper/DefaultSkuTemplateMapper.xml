<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.DefaultSkuTemplateMapper">

    <resultMap type="com.lin.distribution.domain.DefaultSkuTemplate" id="DefaultSkuTemplateResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="customerGroupId" column="customer_group_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectDefaultSkuTemplateVo">
        select id, name, customer_group_id, status, created_at, updated_at
        from default_sku_template
    </sql>

    <select id="selectDefaultSkuTemplateById" parameterType="Long" resultMap="DefaultSkuTemplateResult">
        <include refid="selectDefaultSkuTemplateVo"/>
        where id = #{id}
    </select>

    <select id="selectDefaultSkuTemplateList" parameterType="com.lin.distribution.domain.DefaultSkuTemplate"
            resultMap="DefaultSkuTemplateResult">
        <include refid="selectDefaultSkuTemplateVo"/>
        <where>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="customerGroupId != null">and customer_group_id = #{customerGroupId}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by id desc
    </select>

    <insert id="insertDefaultSkuTemplate" parameterType="com.lin.distribution.domain.DefaultSkuTemplate"
            useGeneratedKeys="true" keyProperty="id">
        insert into default_sku_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="customerGroupId != null">customer_group_id,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="customerGroupId != null">#{customerGroupId},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="updateDefaultSkuTemplate" parameterType="com.lin.distribution.domain.DefaultSkuTemplate">
        update default_sku_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="customerGroupId != null">customer_group_id = #{customerGroupId},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDefaultSkuTemplateById" parameterType="Long">
        delete from default_sku_template where id = #{id}
    </delete>

    <delete id="deleteDefaultSkuTemplateByIds" parameterType="Long">
        delete from default_sku_template where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
