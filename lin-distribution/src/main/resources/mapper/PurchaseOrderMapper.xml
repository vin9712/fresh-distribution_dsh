<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.PurchaseOrderMapper">

    <resultMap type="com.lin.distribution.domain.PurchaseOrder" id="PurchaseOrderResult">
        <result property="id"    column="id"    />
        <result property="code"    column="code"    />
        <result property="orderDate"    column="order_date"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceOrderIds"    column="source_order_ids"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="purchaser"    column="purchaser"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectPurchaseOrderVo">
        select id, code, order_date, source_type, source_order_ids, supplier_id, supplier_name, purchaser, total_amount, status, create_by, create_time, update_by, update_time, remark from purchase_order
    </sql>

    <select id="selectPurchaseOrderList" parameterType="com.lin.distribution.domain.PurchaseOrder" resultMap="PurchaseOrderResult">
        <include refid="selectPurchaseOrderVo"/>
        <where>
            <if test="code != null  and code != ''"> and code like concat('%', #{code}, '%')</if>
            <if test="orderDate != null "> and order_date = #{orderDate}</if>
            <if test="beginOrderDate != null "> and order_date &gt;= #{beginOrderDate}</if>
            <if test="endOrderDate != null "> and order_date &lt;= #{endOrderDate}</if>
            <if test="sourceType != null "> and source_type = #{sourceType}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by order_date desc, id desc
    </select>

    <select id="selectPurchaseOrderById" parameterType="Long" resultMap="PurchaseOrderResult">
        <include refid="selectPurchaseOrderVo"/>
        where id = #{id}
    </select>

    <insert id="insertPurchaseOrder" parameterType="com.lin.distribution.domain.PurchaseOrder" useGeneratedKeys="true" keyProperty="id">
        insert into purchase_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">code,</if>
            <if test="orderDate != null">order_date,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceOrderIds != null">source_order_ids,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null">supplier_name,</if>
            <if test="purchaser != null">purchaser,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null and code != ''">#{code},</if>
            <if test="orderDate != null">#{orderDate},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceOrderIds != null">#{sourceOrderIds},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null">#{supplierName},</if>
            <if test="purchaser != null">#{purchaser},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePurchaseOrder" parameterType="com.lin.distribution.domain.PurchaseOrder">
        update purchase_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="code != null and code != ''">code = #{code},</if>
            <if test="orderDate != null">order_date = #{orderDate},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceOrderIds != null">source_order_ids = #{sourceOrderIds},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null">supplier_name = #{supplierName},</if>
            <if test="purchaser != null">purchaser = #{purchaser},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePurchaseOrderByIds" parameterType="String">
        delete from purchase_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectSourceOrderIdsByDeliveryDate" resultType="java.lang.Long">
        select distinct d.order_id
        from t_sale_order_detail d
        join t_sale_order o on o.id = d.order_id
        where o.status = 1
          and o.delivery_date = #{deliveryDate}
          and o.is_deleted = 0
          and d.is_deleted = 0
        order by d.order_id
    </select>

</mapper>
