<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.ReturnItemMapper">

    <resultMap type="com.lin.distribution.domain.ReturnItem" id="ReturnItemResult">
        <result property="id"    column="id"    />
        <result property="returnId"    column="return_id"    />
        <result property="acceptanceItemId"    column="acceptance_item_id"    />
        <result property="skuId"    column="sku_id"    />
        <result property="skuCode"    column="sku_code"    />
        <result property="productName"    column="product_name"    />
        <result property="productSpec"    column="product_spec"    />
        <result property="productUnit"    column="product_unit"    />
        <result property="returnQuantity"    column="return_quantity"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="amount"    column="amount"    />
        <result property="qualityResult"    column="quality_result"    />
        <result property="qualityNote"    column="quality_note"    />
    </resultMap>

    <sql id="selectReturnItemVo">
        select ri.id, ri.return_id, ri.acceptance_item_id, ri.sku_id,
        sku.code as sku_code,
        ri.product_name, ri.product_spec, ri.product_unit, ri.return_quantity, ri.unit_price, ri.amount,
        ri.quality_result, ri.quality_note
        from t_return_item ri
        left join t_product_sku sku on ri.sku_id = sku.id
    </sql>

    <select id="selectReturnItemList" parameterType="com.lin.distribution.domain.ReturnItem" resultMap="ReturnItemResult">
        <include refid="selectReturnItemVo"/>
        <where>
            <if test="returnId != null "> and ri.return_id = #{returnId}</if>
            <if test="acceptanceItemId != null "> and ri.acceptance_item_id = #{acceptanceItemId}</if>
            <if test="productName != null  and productName != ''"> and ri.product_name like concat('%', #{productName}, '%')</if>
            <if test="qualityResult != null "> and ri.quality_result = #{qualityResult}</if>
        </where>
        order by ri.id
    </select>

    <select id="selectReturnItemById" parameterType="Long" resultMap="ReturnItemResult">
        <include refid="selectReturnItemVo"/>
        where ri.id = #{id}
    </select>

    <select id="selectListByReturnId" parameterType="Long" resultMap="ReturnItemResult">
        <include refid="selectReturnItemVo"/>
        where ri.return_id = #{returnId}
        order by ri.id
    </select>

    <!-- 按验收明细行累计已退数量（含草稿/已提交占用防超退，已完成 status=3 不再占用；
         excludeReturnId 非空时排除该退货单自身占用，草稿改单重算用） -->
    <select id="sumReturnedByAcceptanceItemIds" resultMap="ReturnItemResult">
        select ri.acceptance_item_id,
               coalesce(sum(ri.return_quantity), 0) as return_quantity
        from t_return_item ri
        join t_return_order ro on ro.id = ri.return_id and ro.is_deleted = 0 and ro.status &lt;&gt; 3
        where ri.acceptance_item_id in
        <foreach item="id" collection="acceptanceItemIds" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="excludeReturnId != null"> and ro.id != #{excludeReturnId}</if>
        group by ri.acceptance_item_id
    </select>

    <delete id="deleteByReturnId" parameterType="Long">
        delete from t_return_item where return_id = #{returnId}
    </delete>

    <insert id="insertReturnItem" parameterType="com.lin.distribution.domain.ReturnItem" useGeneratedKeys="true" keyProperty="id">
        insert into t_return_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnId != null">return_id,</if>
            <if test="acceptanceItemId != null">acceptance_item_id,</if>
            <if test="skuId != null">sku_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="productSpec != null">product_spec,</if>
            <if test="productUnit != null">product_unit,</if>
            <if test="returnQuantity != null">return_quantity,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="amount != null">amount,</if>
            <if test="qualityResult != null">quality_result,</if>
            <if test="qualityNote != null">quality_note,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnId != null">#{returnId},</if>
            <if test="acceptanceItemId != null">#{acceptanceItemId},</if>
            <if test="skuId != null">#{skuId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="productSpec != null">#{productSpec},</if>
            <if test="productUnit != null">#{productUnit},</if>
            <if test="returnQuantity != null">#{returnQuantity},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="amount != null">#{amount},</if>
            <if test="qualityResult != null">#{qualityResult},</if>
            <if test="qualityNote != null">#{qualityNote},</if>
         </trim>
    </insert>

    <insert id="batchInsertReturnItem" useGeneratedKeys="true" keyProperty="id">
        insert into t_return_item
            (return_id, acceptance_item_id, sku_id, product_name, product_spec, product_unit,
             return_quantity, unit_price, amount, quality_result, quality_note)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.returnId}, #{item.acceptanceItemId}, #{item.skuId}, #{item.productName}, #{item.productSpec}, #{item.productUnit},
             #{item.returnQuantity}, #{item.unitPrice}, #{item.amount}, #{item.qualityResult}, #{item.qualityNote})
        </foreach>
    </insert>

    <update id="updateReturnItem" parameterType="com.lin.distribution.domain.ReturnItem">
        update t_return_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="returnId != null">return_id = #{returnId},</if>
            <if test="acceptanceItemId != null">acceptance_item_id = #{acceptanceItemId},</if>
            <if test="skuId != null">sku_id = #{skuId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="productSpec != null">product_spec = #{productSpec},</if>
            <if test="productUnit != null">product_unit = #{productUnit},</if>
            <if test="returnQuantity != null">return_quantity = #{returnQuantity},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="qualityResult != null">quality_result = #{qualityResult},</if>
            <if test="qualityNote != null">quality_note = #{qualityNote},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteReturnItemById" parameterType="Long">
        delete from t_return_item where id = #{id}
    </delete>
</mapper>
