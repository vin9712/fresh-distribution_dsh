<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.DeliveryPrintConfigVersionMapper">

    <resultMap type="com.lin.distribution.domain.DeliveryPrintConfigVersion" id="DeliveryPrintConfigVersionResult">
        <result property="id"              column="id"              />
        <result property="deliveryOrderId" column="delivery_order_id" />
        <result property="versionNo"       column="version_no"      />
        <result property="splitMode"       column="split_mode"      />
        <result property="mediaType"       column="media_type"      />
        <result property="rowsPerPage"     column="rows_per_page"   />
        <result property="structureJson"   column="structure_json"  />
        <result property="autoGenerated"   column="auto_generated"  />
        <result property="changeNote"      column="change_note"     />
        <result property="createBy"        column="create_by"       />
        <result property="createTime"      column="create_time"     />
    </resultMap>

    <sql id="selectDeliveryPrintConfigVersionVo">
        select id, delivery_order_id, version_no, split_mode, media_type, rows_per_page,
               structure_json, auto_generated, change_note, create_by, create_time
        from t_delivery_print_config_version
    </sql>

    <select id="selectByDeliveryOrderId" parameterType="Long" resultMap="DeliveryPrintConfigVersionResult">
        <include refid="selectDeliveryPrintConfigVersionVo"/>
        where delivery_order_id = #{deliveryOrderId}
        order by version_no desc
    </select>

    <select id="selectMaxVersionNo" parameterType="Long" resultType="Integer">
        select coalesce(max(version_no), 0)
        from t_delivery_print_config_version
        where delivery_order_id = #{deliveryOrderId}
    </select>

    <insert id="insertDeliveryPrintConfigVersion" parameterType="com.lin.distribution.domain.DeliveryPrintConfigVersion" useGeneratedKeys="true" keyProperty="id">
        insert into t_delivery_print_config_version
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryOrderId != null">delivery_order_id,</if>
            <if test="versionNo != null">version_no,</if>
            <if test="splitMode != null and splitMode != ''">split_mode,</if>
            <if test="mediaType != null and mediaType != ''">media_type,</if>
            <if test="rowsPerPage != null">rows_per_page,</if>
            <if test="structureJson != null">structure_json,</if>
            <if test="autoGenerated != null">auto_generated,</if>
            <if test="changeNote != null and changeNote != ''">change_note,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryOrderId != null">#{deliveryOrderId},</if>
            <if test="versionNo != null">#{versionNo},</if>
            <if test="splitMode != null and splitMode != ''">#{splitMode},</if>
            <if test="mediaType != null and mediaType != ''">#{mediaType},</if>
            <if test="rowsPerPage != null">#{rowsPerPage},</if>
            <if test="structureJson != null">#{structureJson},</if>
            <if test="autoGenerated != null">#{autoGenerated},</if>
            <if test="changeNote != null and changeNote != ''">#{changeNote},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>
</mapper>
