<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lin.distribution.mapper.MonthAdjustmentMapper">

    <resultMap type="com.lin.distribution.domain.MonthAdjustment" id="MonthAdjustmentResult">
        <result property="id"                  column="id"                 />
        <result property="code"                column="code"               />
        <result property="customerId"          column="customer_id"        />
        <result property="billMonth"           column="bill_month"         />
        <result property="receivableAmount"    column="receivable_amount"  />
        <result property="purchaseCostAmount"  column="purchase_cost_amount"/>
        <result property="status"              column="status"             />
        <result property="remark"              column="remark"             />
        <result property="isDeleted"           column="is_deleted"         />
        <result property="createTime"          column="create_time"        />
    </resultMap>

    <sql id="selectVo">
        select id, code, customer_id, bill_month, receivable_amount, purchase_cost_amount,
               status, remark, is_deleted, create_time
        from t_month_adjustment
    </sql>

    <select id="selectById" parameterType="Long" resultMap="MonthAdjustmentResult">
        <include refid="selectVo"/>
        where id = #{id}
    </select>

    <select id="selectList" parameterType="com.lin.distribution.domain.MonthAdjustment" resultMap="MonthAdjustmentResult">
        <include refid="selectVo"/>
        <where>
            and is_deleted = 0
            <if test="customerId != null">and customer_id = #{customerId}</if>
            <if test="billMonth != null and billMonth != ''">and bill_month = #{billMonth}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="code != null and code != ''">and code = #{code}</if>
        </where>
        order by id desc
    </select>

    <insert id="insert" parameterType="com.lin.distribution.domain.MonthAdjustment"
            useGeneratedKeys="true" keyProperty="id">
        insert into t_month_adjustment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="code != null">code,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="billMonth != null">bill_month,</if>
            <if test="receivableAmount != null">receivable_amount,</if>
            <if test="purchaseCostAmount != null">purchase_cost_amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="isDeleted != null">is_deleted,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="code != null">#{code},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="billMonth != null">#{billMonth},</if>
            <if test="receivableAmount != null">#{receivableAmount},</if>
            <if test="purchaseCostAmount != null">#{purchaseCostAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.lin.distribution.domain.MonthAdjustment">
        update t_month_adjustment
        <trim prefix="SET" suffixOverrides=",">
            <if test="billMonth != null">bill_month = #{billMonth},</if>
            <if test="receivableAmount != null">receivable_amount = #{receivableAmount},</if>
            <if test="purchaseCostAmount != null">purchase_cost_amount = #{purchaseCostAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <!-- 逻辑删除（草稿/已提交保留审计性删除；仅草稿状态由服务层校验后调用） -->
    <update id="deleteById" parameterType="Long">
        update t_month_adjustment
        set is_deleted = 1
        where id = #{id}
    </update>

</mapper>
